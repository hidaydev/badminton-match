# Quadlet unit for the RC API (schema bm2_rc) - rootless podman + systemd user.
#
# Separate from majadu-api.container on purpose (D-030): every name carries
# `majadu-rc-api`, so this unit can never shadow the v1/v2 production unit, and
# `systemctl --user restart majadu-api` keeps meaning production.
#
# The image is built by ops/scripts/deploy-vps-rc.sh and tagged :local; Quadlet
# only ever starts that tag (Pull=never), so a restart cannot fetch a different
# build behind the operator's back.
[Unit]
Description=Majadu API (RC, schema bm2_rc)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=majadu-alert@%N.service

[Container]
Image=localhost/majadu-rc-api:local
ContainerName=majadu-rc-api
Network=qouver
PublishPort=127.0.0.1:8081:8080
Pull=never
EnvironmentFile=/srv/qouver/apps/majadu-rc/env/majadu-rc.env
AutoUpdate=local
UserNS=keep-id:uid=10001
NoNewPrivileges=true
DropCapability=ALL
# Same hardening as production: this unit runs branch code, and it writes no
# file of its own (access lines go to stdout, which is the journal).
ReadOnly=true
Tmpfs=/tmp:size=64m
Tmpfs=/run:size=8m
PidsLimit=256
# Quadlet 5.8.2 on the deploy host rejects DevicePolicy and LogSizeMax outright
# and never creates the service, so rotation is a podman argument here too.
PodmanArgs=--log-opt=max-size=10m
HealthCmd=/bin/bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /readyz HTTP/1.0\r\n\r\n" >&3 && read -r line <&3 && case "$line" in *" 200"*) exit 0;; esac; exit 1'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s

[Service]
# on-failure, not always: a deliberate stop (rebuild, rollback, maintenance)
# must stay stopped.
Restart=on-failure
RestartSec=3
MemoryHigh=400M
MemoryMax=512M
LimitNOFILE=8192

[Install]
WantedBy=default.target