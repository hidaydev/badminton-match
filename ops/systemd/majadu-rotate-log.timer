# Rotates the Majadu logs once an hour.
#
# Enabled by the operator, not by deploy-vps.sh (the deploy only installs unit
# files). See docs/ops/cutover.md for when to enable it; it depends on nothing
# but the log directory, so it is safe before the cutover too.
[Unit]
Description=Rotate the Majadu logs hourly

[Timer]
OnCalendar=hourly
RandomizedDelaySec=2m

[Install]
WantedBy=timers.target