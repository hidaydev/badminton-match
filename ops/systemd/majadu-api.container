# Quadlet unit untuk majadu-api (PROD instance) — rootless podman + systemd user.
# Pola webhook (sds-monorepo): image DIBANGUN LOKAL di VPS oleh deploy-vps.sh
# (localhost/majadu-api:local, Pull=never, AutoUpdate=local) — bukan dari registry.
# Unit server di-update otomatis oleh switch_local_image() saat deploy pertama.
[Unit]
Description=Majadu API (prod, schema bm)
After=network-online.target
Wants=network-online.target
[Container]
Image=localhost/majadu-api:local
ContainerName=majadu-api
Network=qouver
PublishPort=127.0.0.1:8080:8080
Pull=never
EnvironmentFile=/srv/qouver/apps/majadu/env/majadu-prod.env
Volume=/srv/qouver/apps/majadu/logs/main:/logs:Z
AutoUpdate=local
UserNS=keep-id:uid=10001
[Service]
Restart=always
RestartSec=3
[Install]
WantedBy=default.target