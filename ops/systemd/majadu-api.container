# Quadlet unit for majadu-api (PROD instance) - rootless podman + systemd user.
#
# The image is pulled by digest by deploy-vps.sh and tagged :local; Quadlet only
# ever starts that tag (Pull=never), so a `systemctl restart` cannot fetch a
# different build behind the operator's back.
#
# The environment file holds every secret and must stay mode 600
# (deploy-vps.sh refuses to run when it can be read by anyone else).
[Unit]
Description=Majadu API (prod, schema bm2 after the cutover)
After=network-online.target
Wants=network-online.target
# A crash loop must page someone instead of filling the disk quietly. The limit
# is on the unit, so Restart=on-failure stops retrying after five attempts in
# five minutes instead of spinning forever.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=majadu-alert@%N.service

[Container]
Image=localhost/majadu-api:local
ContainerName=majadu-api
Network=qouver
PublishPort=127.0.0.1:8080:8080
# MAJADU_METRICS_PORT binds the registry to 127.0.0.1 inside the container on
# purpose: there is no PublishPort for it, so no proxy or scanner can reach it.
# Read it with `podman exec` (see ADR-007).
Pull=never
EnvironmentFile=/srv/qouver/apps/majadu/env/majadu-prod.env
AutoUpdate=local
UserNS=keep-id:uid=10001
NoNewPrivileges=true
DropCapability=ALL
# The image is immutable at run time: the API writes one JSON line per request to
# stdout and nothing to disk, so journald is the only copy of the access log and
# anything that lands in the image is a defect or an intrusion. The two tmpfs
# mounts are the only writable scratch space a process may need.
ReadOnly=true
Tmpfs=/tmp:size=64m
Tmpfs=/run:size=8m
# A fork bomb in the container stops at the pid limit instead of starving the
# host, and the descriptor limit keeps a leak from exhausting the system table.
PidsLimit=256
# Quadlet 5.8.2, the version on the deploy host, has no DevicePolicy and no
# LogSizeMax key: the generator rejects the whole unit and the service is never
# created. The log rotation is a podman argument instead, and health plus the
# capability drop below are what actually bound this container.
PodmanArgs=--log-opt=max-size=10m
# Health is checked from inside the container against the loopback listener, so
# an operator sees `unhealthy` instead of a process that accepts TCP and fails
# every request. Debian ships bash, and /dev/tcp is the only HTTP client the
# runtime image has.
HealthCmd=/bin/bash -c 'exec 3<>/dev/tcp/127.0.0.1/8080 && printf "GET /readyz HTTP/1.0\r\n\r\n" >&3 && read -r line <&3 && case "$line" in *" 200 "*) exit 0;; esac; exit 1'
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s

[Service]
# on-failure, not always: a deliberate stop (cutover, rollback, maintenance) must
# stay stopped. StartLimit* above bounds the crash case.
Restart=on-failure
RestartSec=3
# MemoryHigh starts reclaiming before MemoryMax kills the process, so the OOM
# kill is the last resort rather than the first symptom.
MemoryHigh=400M
MemoryMax=512M
LimitNOFILE=8192

[Install]
WantedBy=default.target
