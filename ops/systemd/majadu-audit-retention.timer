# Runs audit retention once a month. The threshold is audit.retention_days, so
# a monthly run is enough and a missed one is repaired by the next run.
# Persistent=true catches up after downtime.
[Unit]
Description=Run the Majadu audit retention monthly

[Timer]
OnCalendar=*-*-01 04:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
