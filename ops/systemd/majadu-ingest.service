# Rating ingest tick, started by majadu-ingest.timer.
#
# Sessions are approved faster than the daily snapshot: ratingingest reads every
# approved session of every community and writes the rating events, which is
# what moves the board's asOf window. Every mode is idempotent, so a re-run is
# safe. The image ships the binary because the VPS has no Nim toolchain.
[Unit]
Description=Majadu rating ingest tick
Wants=network-online.target
After=network-online.target majadu-api.service
OnFailure=majadu-alert@%n.service

[Service]
Type=oneshot
# The image ENTRYPOINT is the API, so the tool is selected with --entrypoint;
# an argument after the image name would start a second API instance instead.
ExecStart=/usr/bin/podman run --rm --pull=never --network=qouver \
  --env-file=/srv/qouver/apps/majadu/env/majadu-prod.env \
  --entrypoint /usr/local/bin/ratingingest \
  localhost/majadu-api:local tick
