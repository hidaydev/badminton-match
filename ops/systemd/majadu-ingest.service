# Rating ingest tick, started by majadu-ingest.timer.
#
# Sessions are approved faster than the daily snapshot: ratingingest reads every
# approved session of every community and writes the rating events, which is what
# moves the board's asOf window. Every mode is idempotent, so a re-run is safe.
# The image ships the binary because the VPS has no Nim toolchain.
#
# It loads the job env, not the tool env: this job reads MAJADU_PG_DSN and none
# of the request-serving secrets (OIDC client secret, share-code keyring) and no
# credential that can change the schema, read the staging copy or dump the
# database. The tool env still holds those for the operator scripts.
[Unit]
Description=Majadu rating ingest tick
Wants=network-online.target qouver-postgres.service
After=network-online.target qouver-postgres.service majadu-api.service
OnFailure=majadu-alert@%N.service

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'test -r /srv/qouver/apps/majadu/env/majadu-job.env || { echo "majadu-job.env is missing; install it from ops/env/prod-job.env.example" >&2; exit 1; }'
# The image ENTRYPOINT is the API, so the tool is selected with --entrypoint; an
# argument after the image name would start a second API instance instead.
ExecStart=/usr/bin/podman run --rm --pull=never --network=qouver \
  --env-file=/srv/qouver/apps/majadu/env/majadu-job.env \
  --entrypoint /usr/local/bin/ratingingest \
  localhost/majadu-api:local tick
