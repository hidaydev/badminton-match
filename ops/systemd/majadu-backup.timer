# One dump per day, off the janitor's hour so two jobs never hold the database
# container at once. Persistent=true catches up after downtime, and the script
# itself verifies each dump with `pg_restore --list` before it keeps the file.
#
# Enabled by the operator, not by deploy-vps.sh (the deploy only installs unit
# files). See docs/ops/cutover.md for when to enable it.
[Unit]
Description=Run the Majadu database dump daily

[Timer]
OnCalendar=*-*-* 02:15:00
RandomizedDelaySec=15m
Persistent=true

[Install]
WantedBy=timers.target
