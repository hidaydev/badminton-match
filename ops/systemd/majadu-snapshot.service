# Daily rank snapshot, started by majadu-snapshot.timer.
#
# ranksnapshot loops platform.community and, per community, reads the board and
# upserts rating.snapshots. It reads MAJADU_PG_DSN and nothing else.
#
# It loads the job env, not the tool env: the tool env also carries
# MAJADU_OWNER_DSN, MAJADU_ETL_DSN and the backup DSNs, and a snapshot writer has
# no use for the role that can change the schema.
[Unit]
Description=Majadu daily rank snapshot
Wants=network-online.target qouver-postgres.service
After=network-online.target qouver-postgres.service majadu-api.service
OnFailure=majadu-alert@%N.service

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'test -r /srv/qouver/apps/majadu/env/majadu-job.env || { echo "majadu-job.env is missing; install it from ops/env/prod-job.env.example" >&2; exit 1; }'
# The image ENTRYPOINT is the API, so the tool is selected with --entrypoint; an
# argument after the image name would start a second API instance instead.
ExecStart=/usr/bin/podman run --rm --pull=never --network=qouver \
  --env-file=/srv/qouver/apps/majadu/env/majadu-job.env \
  --entrypoint /usr/local/bin/ranksnapshot \
  localhost/majadu-api:local
