# Nightly database dump, started by majadu-backup.timer.
#
# `ops/scripts/backup.sh` was already written to run on a schedule ("Nightly
# dump of the databases"), but nothing started it: the only caller was
# cutover.sh, so the runbook checkbox "The daily bm2 backup runs" had no unit
# behind it. This is that unit, and it follows the host-check / audit-digest
# shape: the script is the operator script deploy-vps.sh keeps in sync with the
# repository, and it reads the tool env itself because the DSNs it needs (owner
# for bm2, the archive DSN for bm) are the tool file's contents.
#
# The script fails closed when the bm2 owner DSN is missing, so a host that was
# never given `MAJADU_BACKUP_DSN_BM2` (or `MAJADU_OWNER_DSN`) shows up as a red
# unit instead of a silently missing dump.
[Unit]
Description=Majadu nightly database dump
Wants=network-online.target
After=network-online.target
OnFailure=majadu-alert@%N.service

[Service]
Type=oneshot
# A hung pg_dump never exits, so without this the unit sits `activating` forever:
# it never fails, never pages, and the timer's next fire is skipped as "still
# running". 30 minutes is far above a real dump of this database (16 s at 1.4 GB).
TimeoutStartSec=1800
ExecStart=/bin/bash /srv/qouver/apps/majadu/scripts/backup.sh
