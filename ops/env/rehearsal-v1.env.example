# Environment for the v1 image inside a rehearsal (T-063).
#
# Install as <rehearsal env dir>/v1.env with mode 600; rehearse.sh copies it into
# the sandbox and never reads it from /srv. These are the names the archived Go
# image understands, not the v2 names on purpose: the rehearsal starts the image
# that rollback.sh will restore.
#
# DATABASE_URL must point at the rehearsal staging database (the one restored
# from a staging dump), because the v1 image needs the `bm` schema to answer
# /healthz.

DATABASE_URL=postgres://REHEARSAL_USER:CHANGE_ME@qouver-postgres:5432/bm_staging
MAJADU_DB_SCHEMA=bm
MAJADU_ENV=dev
PORT=8080
MAJADU_ADMIN_TOKEN=CHANGE_ME

# Optional, same meaning as in production.
# MAJADU_LOG_DIR=/logs
