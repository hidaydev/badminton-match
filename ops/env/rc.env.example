# Environment for the RC API instance (schema bm2_rc, port 8081).
#
# Installed on the VPS as /srv/qouver/apps/majadu-rc/env/majadu-rc.env with mode
# 600 inside a 700 directory. Nothing here is a business parameter; business
# values live in platform.config.
#
# This file must never point at the production database. The role names carry
# `_rc` for the same reason: a copy-paste mistake has to fail to connect rather
# than write to bm or bm2.

MAJADU_ENV=prod
MAJADU_PORT=8080
# Bound inside the container only; there is no PublishPort for it.
MAJADU_METRICS_PORT=9090
MAJADU_DRAIN_MS=5000
MAJADU_SHUTDOWN_TIMEOUT_MS=30000

MAJADU_PG_DSN=postgres://bm2_app:CHANGE_ME@qouver-postgres:5432/bm2_rc
# The owner DSN is a deploy and bootstrap secret, so it lives in
# majadu-rc-tools.env (see rc-tools.env.example). The RC API unit loads only
# this file.
# The role names are the migration's, not the instance's: 0001-0029 grant to
# bm2_app by name. The database name is what isolates this instance, and
# deploy-vps-rc.sh refuses an env file whose DSN is not bm2_rc.

# Rootless port forwarding presents the RC container's own address as the peer,
# and netavark changes that address on every recreate, so the unit pins
# IP=10.89.0.250 and this value must match it. Trusting 127.0.0.1 or the bridge
# gateway 10.89.0.1 silently collapses every anonymous caller into one bucket;
# verify with identity_resolution{source="header"} on /metrics after a restart.
MAJADU_TRUSTED_PROXIES=10.89.0.250
PUBLIC_BASE_URL=https://api.qouver.com
# The RC SPA. The API is reached through the Vercel rewrite on the same origin,
# so this list only guards direct cross-origin calls.
CORS_ALLOWED_ORIGINS=https://majadu-rc.vercel.app

# Separate keyring: share links written by the RC must not be readable with the
# production keys, and vice versa.
SHARE_CODE_KEYS={"1":"CHANGE_ME"}
SHARE_CODE_ACTIVE_KEY_ID=1

OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
# Stays on the SPA origin: Google redirects to the Vercel domain, which proxies
# /api/* to this instance. A domain change needs both this value and the
# Authorized redirect URI in the Google console.
OIDC_REDIRECT_URI=https://majadu-rc.vercel.app/api/auth/callback

# Optional, same meaning as in production.
# MAJADU_COOKIE_SECURE=1
# MAJADU_LOG_DIR=/logs