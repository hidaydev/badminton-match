# Tool environment for the production deploy, cutover and one-shot job units,
# installed on the VPS as /srv/qouver/apps/majadu/env/majadu-tools.env with mode
# 600 and owned by the deploy user.
#
# The API unit (majadu-api.container) never loads this file: its EnvironmentFile
# is majadu-prod.env, which carries only the variables the request path reads.
# The one-shot job units (majadu-ingest, majadu-janitor, majadu-snapshot,
# majadu-audit-retention) load this file as their only --env-file. deploy-vps.sh,
# cutover.sh and rollback.sh read it directly. That is why it holds both the
# application DSN those jobs need and the roles that can change the schema or
# read the staging copy, and why the OIDC client secret and the share-code
# keyring are not here: the deploy refuses a tools file that carries them.

# Same credential as MAJADU_PG_DSN in majadu-prod.env. The job units run as the
# application role and no longer load the API file, so the value lives in both
# files; rotating bm2_app means editing both in the same step.
MAJADU_PG_DSN=postgres://bm2_app:CHANGE_ME@qouver-postgres:5432/bm2

MAJADU_OWNER_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm2
MAJADU_ETL_DSN=postgres://bm2_etl:CHANGE_ME@qouver-postgres:5432/bm2

# The nightly bm2 dump is taken as the owner, not as bm2_app: the application
# role cannot see dbtools.schema_migrations, and a dump without the ledger
# restores into a database that cannot be verified. backup.sh reads this key
# from this file when the environment does not set it.
MAJADU_BACKUP_DSN_BM2=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm2

# The import source is bm_staging after the v1 dump is restored there. The role
# must have SELECT on schema bm in bm_staging; do not use bm2_etl, which has no
# grant on that schema. bm2_owner works when it performed the restore and owns
# the restored objects, or provision a read-only role for the staging copy.
MAJADU_ETL_SOURCE_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm_staging

# restore.sh --recreate drops and creates bm_staging, so this role must own that
# database or have CREATEDB. It is separate from the ETL role on purpose:
# bm2_etl cannot recreate a database and must not be granted the right.
MAJADU_CUTOVER_RESTORE_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm_staging

# DSN for majadu-audit-retention.timer. It belongs to bm2_audit_prune, not to
# bm2_owner: the pruning role has SELECT and DELETE on account.audit and no
# rights anywhere else, so the timer cannot alter the schema. Enable login once
# with `alter role bm2_audit_prune login password '<secret>'` in ops/db/roles.sql
# output, and keep the assignment active: this file is the only env file the
# timer loads, so a commented value here is a timer that fails every run.
MAJADU_AUDIT_DSN=postgres://bm2_audit_prune:CHANGE_ME@qouver-postgres:5432/bm2

# Optional: cutover.sh sets these role passwords in prepare-bm2 when they are
# exported in its environment. Do not put them here unless cutover is run with
# this file sourced.
# BM2_OWNER_PASSWORD=CHANGE_ME
# BM2_APP_PASSWORD=CHANGE_ME
# BM2_ETL_PASSWORD=CHANGE_ME
