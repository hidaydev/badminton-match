# Environment for the v2 API (schema bm2), installed on the VPS as
# /srv/qouver/apps/majadu/env/majadu-prod.env with mode 600.
#
# Pre-cutover the live file points at `bm` and is the v1 file; cutover.sh moves
# this symlink only after the ETL and the state row are in place:
#   majadu-prod.env -> majadu-prod.env.v1   (before)
#   majadu-prod.env -> majadu-prod.env.v2   (after)
# rollback.sh moves it back.
#
# This file is the API unit's EnvironmentFile, so it carries only the variables
# the process reads. The owner, ETL and cutover DSNs are in majadu-tools.env,
# which the deploy and cutover tools read and the API unit never loads.

MAJADU_ENV=prod
MAJADU_PORT=8080
# The registry answers only on 127.0.0.1 inside the container; no PublishPort
# maps it, so the public socket never carries /metrics. 0 or empty disables it.
MAJADU_METRICS_PORT=9090
MAJADU_DRAIN_MS=5000
MAJADU_SHUTDOWN_TIMEOUT_MS=30000
MAJADU_PG_DSN=postgres://bm2_app:CHANGE_ME@qouver-postgres:5432/bm2
# Per-connection bounds, applied only to the API pool in apps/api/src/main.nim.
# CLI tools (`dbtools migrate`, `tools/import`, `ratingingest`) open their pool
# without them, so a deploy migration or the cutover ETL is not killed by a web
# timeout. Zero disables a bound; a malformed value falls back to the default.
#   statement_timeout 15000ms, lock_timeout 5000ms, pool checkout 5000ms
MAJADU_DB_STATEMENT_TIMEOUT_MS=15000
MAJADU_DB_LOCK_TIMEOUT_MS=5000
MAJADU_DB_ACQUIRE_TIMEOUT_MS=5000

# Set by cutover.sh to the sha256 of the dump that was imported. /readyz refuses
# to answer 200 when the database carries a different snapshot.
CUTOVER_SNAPSHOT_SHA256=

# Empty means "do not trust X-Forwarded-For"; Caddy appends the client address.
MAJADU_TRUSTED_PROXIES=127.0.0.1

PUBLIC_BASE_URL=https://api.qouver.com
CORS_ALLOWED_ORIGINS=https://majadu.vercel.app

# The only copy of these keys is on the VPS (O-23). Losing this file makes every
# existing share link permanently unreadable.
SHARE_CODE_KEYS={"1":"CHANGE_ME"}
SHARE_CODE_ACTIVE_KEY_ID=1

OIDC_CLIENT_ID=CHANGE_ME
# A Google "Web application" client is confidential: the token endpoint rejects
# the exchange without this. Leave it empty only for a public client.
OIDC_CLIENT_SECRET=CHANGE_ME
# Stays on the SPA origin: the browser calls /api/* same-origin (vercel.json
# rewrites it to api.qouver.com/majadu/*), so the auth-flow and session cookies
# are first-party. Google redirects here, never to https://api.qouver.com/auth/*.
OIDC_REDIRECT_URI=https://majadu.vercel.app/api/auth/callback

# Not read here, but installed next to this file with mode 600:
#   majadu-tools.env  the four one-shot job units (ingest, janitor, snapshot,
#                     audit-retention) load it as their only env file, and the
#                     deploy/cutover scripts read it directly. It carries the
#                     application DSN a second time plus the owner, ETL,
#                     staging-restore, bm2 backup and audit-prune DSNs; see
#                     prod-tools.env.example. MAJADU_BACKUP_DSN_BM2 must be the
#                     owner, not bm2_app, or the dump loses the migration
#                     ledger and the restored database has no bm2_app grants.
#   ghcr-token        read token for ghcr.io (deploy-vps.sh refuses a
#                     world-readable one). Without it the script relies on an
#                     existing podman login.
#   cosign.pub        public key the deploy uses to verify the release digest;
#                     cosign itself must be installed on the host.
#   alert.env         optional MAJADU_ALERT_WEBHOOK for majadu-alert@.service.
# Both prod env files (majadu-prod.env.v1 and .v2), majadu-tools.env, and the
# rest of env/ must stay mode 600 and owned by the deploy user; deploy-vps.sh
# checks the API file and the tool file.
