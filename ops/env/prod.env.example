# Environment for the v2 API (schema bm2), installed on the VPS as
# /srv/qouver/apps/majadu/env/majadu-prod.env with mode 600.
#
# Pre-cutover the live file points at `bm` and is the v1 file; cutover.sh moves
# this symlink only after the ETL and the state row are in place:
#   majadu-prod.env -> majadu-prod.env.v1   (before)
#   majadu-prod.env -> majadu-prod.env.v2   (after)
# rollback.sh moves it back.
#
# MAJADU_PG_DSN is the only database setting the process reads; the owner and
# ETL DSNs are for cutover.sh, which needs DDL rights and a role that can read
# bm_staging. Keeping all three in one file means a restore has one source.

MAJADU_ENV=prod
MAJADU_PORT=8080
MAJADU_DRAIN_MS=5000
MAJADU_SHUTDOWN_TIMEOUT_MS=30000
MAJADU_PG_DSN=postgres://bm2_app:CHANGE_ME@qouver-postgres:5432/bm2
MAJADU_OWNER_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm2
MAJADU_ETL_DSN=postgres://bm2_etl:CHANGE_ME@qouver-postgres:5432/bm2
MAJADU_ETL_SOURCE_DSN=postgres://bm2_etl:CHANGE_ME@qouver-postgres:5432/bm_staging

# Owner DSN for majadu-audit-retention.timer. Pruning account.audit needs the
# owner role, so it must differ from MAJADU_PG_DSN. Left commented until the
# timer is enabled; the unit reads it from this file, not from the environment.
# MAJADU_AUDIT_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm2

# Set by cutover.sh to the sha256 of the dump that was imported. /readyz refuses
# to answer 200 when the database carries a different snapshot.
CUTOVER_SNAPSHOT_SHA256=

# Empty means "do not trust X-Forwarded-For"; Caddy appends the client address.
MAJADU_TRUSTED_PROXIES=127.0.0.1

PUBLIC_BASE_URL=https://api.qouver.com
CORS_ALLOWED_ORIGINS=https://majadu.vercel.app

# The only copy of these keys is on the VPS (O-23). Losing this file makes every
# existing share link permanently unreadable.
SHARE_CODE_KEYS={"1":"CHANGE_ME"}
SHARE_CODE_ACTIVE_KEY_ID=1

OIDC_CLIENT_ID=CHANGE_ME
# A Google "Web application" client is confidential: the token endpoint rejects
# the exchange without this. Leave it empty only for a public client.
OIDC_CLIENT_SECRET=CHANGE_ME
# Stays on the SPA origin: the browser calls /api/* same-origin (vercel.json
# rewrites it to api.qouver.com/majadu/*), so the auth-flow and session cookies
# are first-party. Google redirects here, never to https://api.qouver.com/auth/*.
OIDC_REDIRECT_URI=https://majadu.vercel.app/api/auth/callback

# Not read here, but installed next to this file with mode 600:
#   ghcr-token   read token for ghcr.io (deploy-vps.sh refuses a world-readable
#                one). Without it the script relies on an existing podman login.
#   alert.env    optional MAJADU_ALERT_WEBHOOK for majadu-alert@.service.
# Both prod env files (majadu-prod.env.v1 and .v2) and everything under env/
# must stay 600; deploy-vps.sh checks the one the unit is using.
