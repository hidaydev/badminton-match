# Environment for the v2 image and cutover.sh inside a rehearsal (T-063).
#
# Install as <rehearsal env dir>/v2.env with mode 600. rehearse.sh copies it into
# the sandbox app dir and passes the same paths to cutover.sh; nothing here is
# read by production.
#
# Every database must be the rehearsal one: rehearse.sh refuses bm, bm2,
# bm2_dev and postgres.

MAJADU_ENV=prod
MAJADU_PORT=8080
MAJADU_DRAIN_MS=5000
MAJADU_SHUTDOWN_TIMEOUT_MS=30000
# The process runs as bm2_app and must see bm2_rehearsal.
MAJADU_PG_DSN=postgres://bm2_app:CHANGE_ME@qouver-postgres:5432/bm2_rehearsal
# Production keeps these four in majadu-tools.env, which the API unit never
# loads. The T-063 sandbox installs a single v2 env, so cutover.sh reads them
# from this file when majadu-tools.env is absent.
#
# cutover.sh needs DDL rights, the ETL target is bm2_etl, the import source
# only reads bm_staging, and the restore needs a role that can recreate it.
MAJADU_OWNER_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm2_rehearsal
MAJADU_ETL_DSN=postgres://bm2_etl:CHANGE_ME@qouver-postgres:5432/bm2_rehearsal
MAJADU_ETL_SOURCE_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm_staging
MAJADU_CUTOVER_RESTORE_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm_staging

# Filled by cutover.sh with the dump sha256; /readyz refuses the wrong one.
CUTOVER_SNAPSHOT_SHA256=

MAJADU_TRUSTED_PROXIES=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:18081
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18081

# Share links are not exercised by the rehearsal, but the process requires a
# keyring. Generate a throwaway one; never copy the production keys here.
SHARE_CODE_KEYS={"1":"CHANGE_ME"}
SHARE_CODE_ACTIVE_KEY_ID=1

OIDC_CLIENT_ID=rehearsal
OIDC_REDIRECT_URI=http://127.0.0.1:18081/auth/callback
