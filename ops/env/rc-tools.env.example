# Tool environment for the RC deploy and bootstrap scripts, installed on the VPS
# as /srv/qouver/apps/majadu-rc/env/majadu-rc-tools.env with mode 600 and owned
# by the deploy user.
#
# majadu-rc-api.container loads majadu-rc.env only, so the running RC API never
# sees the owner credential. deploy-vps-rc.sh and bootstrap-rc.sh read this file
# for migrations, role creation and the one-time copy.
#
# The deploy gate refuses all five tool keys in majadu-rc.env, so every one has
# a home here even though the RC scripts currently read only MAJADU_OWNER_DSN.
MAJADU_OWNER_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm2_rc
MAJADU_ETL_DSN=postgres://bm2_etl:CHANGE_ME@qouver-postgres:5432/bm2_rc
MAJADU_ETL_SOURCE_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm_restore_rc
MAJADU_CUTOVER_RESTORE_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm_restore_rc
MAJADU_AUDIT_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm2_rc
