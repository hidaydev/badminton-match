# Tool environment for the RC deploy and bootstrap scripts, installed on the VPS
# as /srv/qouver/apps/majadu-rc/env/majadu-rc-tools.env with mode 600 and owned
# by the deploy user.
#
# majadu-rc-api.container loads majadu-rc.env only, so the running RC API never
# sees the owner credential. deploy-vps-rc.sh and bootstrap-rc.sh read this file
# for migrations, role creation and the one-time copy.
MAJADU_OWNER_DSN=postgres://bm2_owner:CHANGE_ME@qouver-postgres:5432/bm2_rc
