# RC handler: same shape as site-v1/site-v2, own prefix.
#
# Caddy runs as its own user, so the snippet must live somewhere it can read.
# Installed as /etc/caddy/site-rc.caddy (root, mode 644); the live Caddyfile
# keeps `handle /majadu/*` for production and imports this one for the RC:
#
#   import /etc/caddy/site-rc.caddy
#
# Re-install it after editing this file:
#   sudo install -o root -g root -m 644 ops/caddy/site-rc.caddy /etc/caddy/site-rc.caddy
#
# The RC SPA reaches it through the Vercel rewrite
# /api/:path* -> https://api.qouver.com/majadu-rc/:path*
handle /majadu-rc/* {
	uri strip_prefix /majadu-rc
	encode zstd gzip
	reverse_proxy 127.0.0.1:8081 {
		header_up X-Client-IP {http.request.remote.host}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}