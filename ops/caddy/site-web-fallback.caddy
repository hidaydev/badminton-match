# Fallback origin for the built SPA, on the VPS, when Vercel is unreachable.
#
# Vercel is the only entry point today. A Vercel outage, a policy change or an
# account lock takes the product offline while the API and the database are
# healthy, so there is a second origin ready on the same host:
#
#   sudo install -o root -g root -m 644 ops/caddy/site-web-fallback.caddy \
#     /etc/caddy/site-web-fallback.caddy
#
# and one site block in /etc/caddy/Caddyfile:
#
#   majadu-fallback.qouver.com {
#       import /etc/caddy/site-web-fallback.caddy
#   }
#
# Build the client into /srv/qouver/apps/majadu/web first:
#
#   pnpm build:web
#   sudo install -d -o caddy -g caddy -m 755 /srv/qouver/apps/majadu/web
#   sudo rsync -a --delete apps/web/dist/ /srv/qouver/apps/majadu/web/
#
# Before an incident, not during one: add the same hostname to the Google OAuth
# client (`https://majadu-fallback.qouver.com/api/auth/callback`) and make sure
# the API accepts it as `OIDC_REDIRECT_URI` for the duration of the failover.
# The callback is the one piece Caddy cannot move by itself.

encode zstd gzip

# The SPA calls same-origin /api, which Vercel rewrites to the API. Here the
# same path is proxied to the public API host, so the bundle needs no rebuild.
handle /api/* {
	uri strip_prefix /api
	rewrite * /majadu{uri}
	reverse_proxy https://api.qouver.com {
		header_up Host api.qouver.com
		transport http {
			dial_timeout 3s
			read_timeout 30s
		}
		@upstream_error status 500 502 503 504
		handle_response @upstream_error {
			respond "Service temporarily unavailable" 502
		}
	}
}

handle {
	root * /srv/qouver/apps/majadu/web
	header {
		-Server
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.qouver.com wss://api.qouver.com; manifest-src 'self'; worker-src 'self' blob:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
	}
	# A hashed asset is immutable; the shell and the share page never cache, so
	# a failover after a deploy cannot serve yesterday's bundle.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@dynamic path / /index.html /s/*
	header @dynamic Cache-Control "no-store"
	try_files {path} /index.html
	file_server
}
