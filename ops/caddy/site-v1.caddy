# v1 handler: imported inside the existing api.qouver.com site block, where the
# /hooks, /sds and /skyward handlers also live. It must stay a `handle`, never a
# site block: replacing the site would take the other applications down with it.
#
# The /majadu prefix is preserved after the cutover, so the OIDC redirect URI,
# PUBLIC_BASE_URL and the web client do not change.
#
# The edge is not a pass-through: bodies over 1MB are rejected before they reach
# the 512MB container, a hung upstream is bounded by the transport timeouts, and
# a dead upstream gets a static 502 instead of Caddy's default page.
handle /majadu/* {
	uri strip_prefix /majadu
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://api.qouver.com wss://api.qouver.com; manifest-src 'self'; worker-src 'self' blob:; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'"
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Client-IP {http.request.remote.host}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
		transport http {
			dial_timeout 3s
			read_timeout 30s
			write_timeout 30s
		}
		health_uri /readyz
		health_interval 10s
		health_timeout 3s
		lb_try_duration 5s
		@upstream_error status 500 502 503 504
		handle_response @upstream_error {
			respond "Service temporarily unavailable" 502
		}
	}
}
