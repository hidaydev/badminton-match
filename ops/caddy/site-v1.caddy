# v1 handler: imported inside the existing api.qouver.com site block, where the
# /hooks, /sds and /skyward handlers also live. It must stay a `handle`, never a
# site block: replacing the site would take the other applications down with it.
#
# The /majadu prefix is preserved after the cutover, so the OIDC redirect URI,
# PUBLIC_BASE_URL and the web client do not change.
handle /majadu/* {
	uri strip_prefix /majadu
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Client-IP {http.request.remote.host}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}
