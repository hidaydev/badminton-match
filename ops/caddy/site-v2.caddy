# v2 handler: same shape and same prefix as site-v1.caddy. The cutover switches
# the snippet a symlink points at; nothing outside this file changes.
handle /majadu/* {
	uri strip_prefix /majadu
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Client-IP {http.request.remote.host}
		header_up -X-Forwarded-For
		header_up -X-Real-IP
	}
}
