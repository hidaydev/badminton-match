{
  "route": "createSession",
  "request": {
    "method": "POST",
    "path": "/c/parity/sessions",
    "headers": {
      "Cookie": "majadu_session=parity-admin-token",
      "Origin": "http://127.0.0.1:5173"
    },
    "body": "{\"title\":\"New Night\",\"date\":\"2026-12-01\",\"startTime\":\"18:00\"}"
  },
  "expect": {
    "status": 201,
    "body": {
      "date": "2026-12-01",
      "id": "{uuid}",
      "status": "draft",
      "title": "New Night"
    }
  }
}
