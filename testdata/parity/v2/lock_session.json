{
  "route": "lockSession",
  "request": {
    "method": "POST",
    "path": "/c/parity/sessions/40000000-0000-4000-8000-000000000001/lock",
    "headers": {
      "Cookie": "majadu_session=parity-admin-token",
      "Origin": "http://127.0.0.1:5173",
      "If-Match": "\"2\""
    }
  },
  "expect": {
    "status": 200,
    "body": {
      "approvedAt": "{timestamp}",
      "date": "2026-11-03",
      "id": "{uuid}",
      "slotMinutes": 30,
      "startTime": "19:00:00",
      "status": "locked",
      "title": "Tuesday Night",
      "version": 3
    }
  }
}
