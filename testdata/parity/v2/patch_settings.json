{
  "route": "patchSettings",
  "request": {
    "method": "PATCH",
    "path": "/c/parity/settings",
    "headers": {
      "Cookie": "majadu_session=parity-admin-token",
      "Origin": "http://127.0.0.1:5173"
    },
    "body": "{\"api.page_size_default\":25}"
  },
  "expect": {
    "status": 200,
    "body": {
      "values": {
        "api.page_size_default": 25,
        "community.directory_enabled": true,
        "community.join_requests_enabled": true
      }
    }
  }
}
