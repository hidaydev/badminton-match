{
  "route": "patchSettings",
  "request": {
    "method": "PATCH",
    "path": "/c/parity/settings",
    "headers": {
      "Cookie": "majadu_session=parity-admin-token",
      "Origin": "http://127.0.0.1:5173"
    },
    "body": "{\"community.invite_ttl_days\":365}"
  },
  "expect": {
    "status": 400,
    "body": {
      "code": "OVERRIDE_TOO_HIGH",
      "detail": "override exceeds the platform value: community.invite_ttl_days",
      "i18nKey": "error.overrideTooHigh",
      "status": 400,
      "title": "OVERRIDE_TOO_HIGH",
      "type": "about:blank"
    }
  }
}
