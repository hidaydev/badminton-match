{
  "route": "getPlayerStats",
  "request": {
    "method": "GET",
    "path": "/c/parity/players/30000000-0000-4000-8000-000000000001/stats",
    "headers": {
      "Cookie": "majadu_session=parity-member-token"
    }
  },
  "expect": {
    "status": 200,
    "body": {
      "games": 4,
      "gender": "F",
      "losses": 2,
      "name": "Alice",
      "playerId": "{uuid}",
      "points": 1250,
      "tier": "B",
      "wins": 2
    }
  }
}
