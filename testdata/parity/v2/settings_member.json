{
  "route": "getSettings",
  "request": {
    "method": "GET",
    "path": "/c/parity/settings",
    "headers": {
      "Cookie": "majadu_session=parity-member-token"
    }
  },
  "expect": {
    "status": 200,
    "body": {
      "effective": {
        "community.default_timezone": {
          "source": "platform",
          "value": "Asia/Jakarta"
        },
        "community.directory_enabled": {
          "source": "community",
          "value": true
        },
        "community.invite_ttl_days": {
          "source": "platform",
          "value": 7
        },
        "community.join_requests_enabled": {
          "source": "community",
          "value": false
        },
        "rating.score_target": {
          "source": "platform",
          "value": 30
        },
        "session.default_scoring_preset": {
          "source": "platform",
          "value": "majadu30"
        }
      },
      "values": {
        "community.directory_enabled": true,
        "community.join_requests_enabled": true
      }
    }
  }
}
