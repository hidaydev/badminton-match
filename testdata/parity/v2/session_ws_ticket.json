{
  "route": "postSessionWsTicket",
  "request": {
    "method": "POST",
    "path": "/c/parity/sessions/40000000-0000-4000-8000-000000000001/ws-ticket",
    "headers": {
      "Cookie": "majadu_session=parity-owner-token",
      "Origin": "http://127.0.0.1:5173"
    }
  },
  "expect": {
    "status": 200,
    "body": {
      "expiresIn": 60,
      "ticket": "{ticket}"
    }
  }
}
