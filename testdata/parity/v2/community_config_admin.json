{
  "route": "getCommunityConfig",
  "request": {
    "method": "GET",
    "path": "/c/parity/config",
    "headers": {
      "Cookie": "majadu_session=parity-admin-token"
    }
  },
  "expect": {
    "status": 200,
    "body": {
      "effective": {
        "community.default_timezone": {
          "source": "platform",
          "value": "Asia/Jakarta"
        },
        "community.directory_enabled": {
          "source": "community",
          "value": true
        },
        "community.invite_ttl_days": {
          "source": "platform",
          "value": 7
        },
        "community.join_requests_enabled": {
          "source": "community",
          "value": true
        },
        "rating.score_target": {
          "source": "platform",
          "value": 21
        }
      }
    }
  }
}
