#!/bin/sh
# Single command runner. Target name is the file name in task.d/.
set -eu

REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export REPO_ROOT

usage() {
  cat <<'EOF'
Usage: ./task <target> [args...]

Targets:
  check        format, nim check, archcheck, unit tests (no database)
  build        release build of the API binary
  test         all tests (unit + integration when a database is present)
  verify       build and test one module: ./task verify <module>
  ci           check + build + test + contract check
  dev-db       create the local PostgreSQL databases and roles
  dev-v1       rebuild the local v1 database (captured schema + synthetic data)
  contract-gen generate Nim routes and the TypeScript client
  contract-check verify the contract fingerprint and generated files
  deps-check   verify installed dependencies against deps.lock
  mock-api     serve the contract as a mock API
  r0-demo      boot the walking skeleton against the local database
  coverage     run coverage gates
  release      prepare a release (dry-run by default)

Environment guaranteed to task.d/*.sh:
  REPO_ROOT, WORKTREE, NIMCACHE_CHECK, NIMCACHE_BUILD
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

target=$1
shift

case "$target" in
  help|-h|--help)
    usage
    exit 0
    ;;
esac

script="$REPO_ROOT/task.d/$target.sh"
if [ ! -f "$script" ]; then
  printf 'Unknown target: %s\n\n' "$target" >&2
  usage >&2
  exit 2
fi

base=$(basename -- "$REPO_ROOT")
base=$(printf '%s' "$base" | tr -cs 'A-Za-z0-9._-' '-')
if command -v shasum >/dev/null 2>&1; then
  digest=$(printf '%s' "$REPO_ROOT" | shasum -a 256 | cut -c1-8)
elif command -v sha256sum >/dev/null 2>&1; then
  digest=$(printf '%s' "$REPO_ROOT" | sha256sum | cut -c1-8)
else
  digest=$(printf '%s' "$REPO_ROOT" | cksum | tr -d ' ' | cut -c1-8)
fi

WORKTREE="${base}-${digest}"
export WORKTREE
NIMCACHE_CHECK="$REPO_ROOT/.cache/$WORKTREE/check"
NIMCACHE_BUILD="$REPO_ROOT/.cache/$WORKTREE/build"
export NIMCACHE_CHECK NIMCACHE_BUILD

mkdir -p "$NIMCACHE_CHECK" "$NIMCACHE_BUILD"

exec sh "$script" "$@"
