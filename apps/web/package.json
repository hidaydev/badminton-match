{
  "name": "badminton-pair-tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-precache.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:types": "tsc -b --pretty false",
    "check:lint": "eslint .",
    "check:tailwind": "node scripts/check-tailwind-arbitrary.mjs",
    "check": "pnpm run check:types && pnpm run check:lint && pnpm run check:tailwind && pnpm run check:touch && pnpm run check:docpaths && pnpm test",
    "test": "vitest run --coverage",
    "check:touch": "node scripts/check-touch-targets.mjs",
    "check:docpaths": "node scripts/check-doc-paths.mjs",
    "check:precache": "node scripts/check-precache.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@majadu/scoreboard-ui": "workspace:*",
    "@majadu/web-client": "workspace:*",
    "@tanstack/react-query": "^5.106.0",
    "lz-string": "^1.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1"
  }
}
