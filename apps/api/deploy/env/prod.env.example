# Env template untuk majadu-api PROD instance (dipakai setelah migrasi prod).
# Salin ke VPS: /srv/qouver/majadu/env/majadu-prod.env (chmod 600).

MAJADU_ENV=prod
PORT=8080
MAJADU_DB_SCHEMA=bm
# Ganti CHANGE_ME dengan password role majadu_app
DATABASE_URL=postgres://majadu_app:CHANGE_ME@qouver-postgres:5432/bm
PUBLIC_BASE_URL=https://api.qouver.com/majadu
CORS_ALLOWED_ORIGINS=https://majadu.vercel.app
