# Quadlet unit untuk majadu-api (DEV instance) — rootless podman + systemd user.
# Pasang di VPS: ~/.config/containers/systemd/majadu-api-dev.container
# lalu: systemctl --user daemon-reload && systemctl --user enable --now majadu-api-dev
# (pastikan: loginctl enable-linger user)
#
# Pola mengikuti qouver-postgres.container yang sudah ada:
#   - Network=qouver (bridge user-defined)
#   - PublishPort=127.0.0.1:{PORT}:{PORT} → Caddy proxy ke host
#   - EnvironmentFile = env secret (mode 600)
# Image di-pull dari ghcr.io (public package — tanpa auth).

[Unit]
Description=Majadu API (dev, schema bm_dev)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/hidaydev/majadu-api:dev
ContainerName=majadu-api-dev
Network=qouver
PublishPort=127.0.0.1:8081:8081
Pull=always
EnvironmentFile=/srv/qouver/majadu/env/majadu-dev.env
# AutoUpdate=registry — aktifkan update via: podman auto-update
AutoUpdate=registry

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
