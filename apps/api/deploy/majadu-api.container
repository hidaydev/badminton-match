# Quadlet unit untuk majadu-api (PROD instance) — dipakai setelah migrasi prod.
# Pasang di VPS: ~/.config/containers/systemd/majadu-api.container

[Unit]
Description=Majadu API (prod, schema bm)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/hidaydev/majadu-api:main
ContainerName=majadu-api
Network=qouver
PublishPort=127.0.0.1:8080:8080
Pull=always
EnvironmentFile=/srv/qouver/majadu/env/majadu-prod.env
AutoUpdate=registry

[Service]
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
