{
  "name": "majadu-score",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-precache.mjs && node scripts/check-headers.mjs",
    "preview": "vite preview",
    "check:types": "tsc -b --pretty false",
    "check": "pnpm run check:types && pnpm run check:tailwind && pnpm test",
    "check:tailwind": "node scripts/check-tailwind-arbitrary.mjs",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@majadu/scoreboard-ui": "workspace:*",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
