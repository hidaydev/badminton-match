#!/bin/sh
# Reject a push that puts internal audits or review notes back in the public
# repository. They live in .local/ (gitignored); the published history was
# rewritten once (T-108) and this hook keeps it that way.
set -eu

if paths=$(git ls-tree -r --name-only HEAD | grep -E '^docs/(audits|plan/reviews)/'); then
  echo "pre-push: these paths belong in .local/, not the public repository:" >&2
  printf '%s\n' "$paths" | head -10 >&2
  echo "pre-push: move them to .local/audits or .local/plan-reviews and commit the removal." >&2
  exit 1
fi

exit 0
