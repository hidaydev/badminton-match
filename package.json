{
  "name": "majadu-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter badminton-pair-tmp dev",
    "build:web": "pnpm --filter badminton-pair-tmp build",
    "check:web": "pnpm --filter badminton-pair-tmp check",
    "dev:api": "cd apps/api && go run ./cmd/server",
    "build:api": "cd apps/api && go build -o bin/majadu-api ./cmd/server",
    "check:api": "cd apps/api && make check"
  }
}
