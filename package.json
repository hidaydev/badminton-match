{
  "name": "majadu-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "pnpm --filter badminton-pair-tmp dev",
    "build:web": "pnpm --filter badminton-pair-tmp build",
    "build:scoreboard": "pnpm --filter majadu-score build",
    "check:web": "pnpm --filter badminton-pair-tmp check && pnpm --filter majadu-score check",
    "check:e2e": "./task e2e visual.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "playwright": "^1.64.1"
  }
}
