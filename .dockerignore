# The image build needs shared/, apps/api/, db/ and tools/ only; everything else
# would be sent to the daemon on every build for nothing.
.git
.cache
node_modules
apps/web
e2e
docs
packages
ops
testdata
# Secrets and local state never belong in a build context: the context is
# uploaded to the daemon before the Dockerfile decides what to copy.
.env.local
.local
dist
